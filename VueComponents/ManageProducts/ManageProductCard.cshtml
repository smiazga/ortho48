<script type="text/x-template" id="manage-product-card-template">

        <div class="d-flex justify-content-between align-items-center py-2 manageproduct-border">
            <div class="">
                <input type="checkbox" :id="'select-' + product.Id" :value="product.Id" @@input="emitUpdate($event, productId)" />
            </div>
            <div class="w-25">
                <div><img :src="product.ImageUrl" alt="" width="190" height="190" /></div>
            </div>
            <div class=" w-100 p-3">
                <div>{{ product.Name}}</div>
                <div>{{ product.MainCategories }}</div>
            </div>
            <div class="w-50">
                <div>60 CT: $5.50</div>
                <div>90 CT: $8.25</div>
                <div>120 CT: $11.00</div>
            </div>
            <div class="adjustcolumn w-25">
                <div class="manageproducts-visible" :class="{hidden: isChecked}">{{ showVisibilityText }}</div>
            </div>
        </div>
</script>

<script type="text/javascript">
    const manageProductCard = {
        template:'#manage-product-card-template',
        props: {
            product: {
                type: Object,
                required: true
            },
        },
        data() {
            return {
                isChecked:false
            }
        },
        computed: {
            showVisibilityText() {
                if (this.isChecked) {
                    return "Hidden";
                } else {
                    return "Visible";
                }
            }
        },
        methods: {
            emitUpdate($event, productId) {
                var checkbox = $event.target;
                this.isChecked = checkbox.checked;
                this.$emit('update-item', productId);
            },
        }   
    }
</script>

<style>
    .adjustcolumn {
        flex: 1;
        padding: 10px;
        text-align: start;
    }

</style>