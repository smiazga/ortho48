@using Newtonsoft.Json;

@Html.Partial("~/VueComponents/ManageProducts/ManageProductCard.cshtml")

<div id="products">
    <div class="products-general-container">

        <div class="products-top-bar-heading display-4 my-3 productsdesktop">
            Products
        </div>

        <div class="products-top-bar-info d-lg-flex flex-row align-items-center justify-content-between py-3 mb-4 productsdesktop">
            <div class="products-top-bar-info-results">
            </div>
            <div class="d-flex align-items-center">
                <input type="text" placeholder="product name" v-model="searchTerm" />
                <div class="products-top-bar-info-active-filters filterpack">
                    <template v-for="(name, index ) in filters" :key="index">
                        <span class="products-top-bar-info-filter filterpack">
                            &nbsp;{{ name }}&nbsp;<span class="products-top-info-filter-close filterpack" @@click="removeFilter(name)">
                                x
                            </span>
                        </span>
                    </template>
                </div>
                <button class="products-top-bar-info-btn mr-5 px-2" id="clear_filters" @@click="clearFilters()">
                    Clear all
                    filters
                </button>
                <div class="products-top-bar-info-dropdown">
                    <select class="products-top-bar-info-dropdown-wrapper" @@change="sortProductOrder($event)">
                        <option value="NameASC">Sort By Name</option>
                        <option value="NameDESC">Sort By Name Descending</option>
                        <option value="PriceDESC">Sort By Price (High to Low)</option>
                        <option value="PriceASC">Sort By Price (Low to High)</option>
                    </select>
                </div>
            </div>
        </div>

        <br />

        <div class="products-content-wrapper">
            <div>
                <div class="filters-wrapper d-none d-lg-block">
                    <div class="products-filters">
                        <div v-for="f in setProductFilters" class="product-filters-item pb-5">
                            <div class="product-filters-item-heading pb-3">{{ f.label}}</div>
                            <div class="product-filters-item-divider"></div>
                            <div v-for="(filter, index) in FiltersData?.find((g) => g.CategoryName == f.category)?.FilterValues"
                                 :key="index">
                                <label>
                                    <input type="checkbox" :id="filter.Name" :value="filter.Name" v-model="filters" />
                                    {{ filter.Name }}
                                </label>
                            </div>
                        </div>
                        <div class="product-filters-item pb-5">
                            <div class="product-filters-item-heading pb-3">Ingredients</div>
                            <div class="product-filters-item-divider"></div>
                            <input type="text" v-model="ingredientSearch" placeholder="Type at least 3 letters" class="product-filters-item-search">
                            <div v-if="ingredientSearch.length > 2">
                                <div v-for="(filter, index) in FiltersData?.find((f) => f.CategoryName == 'Ingredients')?.FilterValues.filter( x => x.Name.toLowerCase().includes(this.ingredientSearch.toLowerCase()))"
                                     :key="index">
                                    <label>
                                        <input type="checkbox" :id="filter.Name" :value="filter.Name"
                                               v-model="filters" />
                                        {{ filter.Name.trim() }}
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div>
                Select All
                <input type="checkbox" :checked="allSelected" @@change="toggleSelectAll" />
                <div>count:{{ selectedCount }}</div>
            </div>
            <div class="products-container">
                <template v-for="prod in this.filterProducts" :key="prod.Id"> 
                    <div>
                        <input type="checkbox" v-model="selectedItems" :value="prod.Id" />
                        <div v-if="selectedItems.includes(prod.Id)">Visible</div>
                        <div v-else>Hidden</div>
                    </div>
                    <manage-product-card :product="prod" />
                </template>
            </div>
        </div>
    </div>



</div>

<script>
    const products = Vue.createApp({
        data() {
            return {
                Products:[],
                FiltersData:[],
                filteredResults: [],
                filters:[],
                ingredientSearch:'',
                productFilters: [],
                searchTerm: '',
                selectedItems: [],
            }
        },
        computed: {
            allSelected() {
                return this.selectedItems.length === this.filteredResults.length;
            },
            filterProducts() {
                return this.getFilterProducts();
            },
            setProductFilters() {
                this.productFilters.push({label:'Category',category: "MainCategories"});
                this.productFilters.push({label:'Health Needs',category: "HealthCategories"});
                this.productFilters.push({label:'Product Form',category: "AvailableIn"});
                return this.productFilters;
            },
            selectedCount() {
                return this.selectedItems.length;
            },
        },
        methods: {
            removeFilter(item){
                let itemIndex = this.filters.findIndex(c => c == item);
                this.filters.splice(itemIndex, 1);
            },
            clearFilters() {
                this.filters = [];
            },
            sortProductOrder(event) {
                var sortName = event.target.value;
                if (sortName == null) {
                    return;
                }
                if (sortName == 'NameASC') {
                    return this.filteredResults.sort((a, b) => {
                        return a.Name > b.Name ? 1 : -1;
                    })
                }
                else if (sortName == 'NameDESC') {
                    return this.filteredResults.sort((a, b) => {
                        return a.Name > b.Name ? -1 : 1;
                    })
                }
                else if (sortName == 'PriceASC') {
                    return this.filteredResults.sort((a, b) => {
                        return a.Price - b.Price;
                    })
                }
                else if (sortName == 'PriceDESC') {
                    return this.filteredResults.sort((a, b) => {
                        return b.Price - a.Price;
                    })
                }
                else {
                    return this.filteredResults;
                }
            },
            toggleSelectAll() {
                if (this.allSelected) {
                    this.selectedItems = [];
                } else {
                    this.selectedItems = this.filteredResults.map(item => item.Id);
                }
            },
            getFilterProducts() {
               if (this.filters.length > 0)
                {
                   this.filteredResults = this.Products.filter((p) => this.filters.every((f) => p.AllCategories.includes(f)));
                }
                else {
                   this.filteredResults = this.Products;
                }

                if (this.searchTerm != '') {
                    const searchTerm = this.searchTerm.toLowerCase();
                     return this.filteredResults.filter((p) => p.Name.toLowerCase().includes(searchTerm));
                }
                return this.filteredResults;
            },



        },
        created: function() {
            this.Products = @Html.Raw(JsonConvert.SerializeObject(Model.ProductsList));
            this.FiltersData = @Html.Raw(JsonConvert.SerializeObject(Model.FiltersList));
        }
    });
    products.component("manage-product-card", manageProductCard);
    products.mount('#products');
</script>