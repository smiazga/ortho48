
<script type="text/template" id="spinner-template">
    <div v-if="isVisible" class="spinner-overlay" role="status">
        <div class="spinner"></div>
    </div>
</script>

<script type="text/javascript">
    const spinner = {
        template: '#spinner-template',
        data() {
            return {
                isVisible: false
            }
        },
        methods: {
            show() {
                this.isVisible = true;
            },
            hide() {
                this.isVisible = false;
            }
        }
    };
</script>

<style>
        .spinner-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1200;
        }

        .spinner {
            border: 8px solid #f3f3f3;
            border-top: 8px solid #3498db;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
</style>

