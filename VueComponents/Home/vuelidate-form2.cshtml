<script src="@Url.Content("https://cdn.jsdelivr.net/npm/vue-demi")"></script>
<script src="@Url.Content("https://cdn.jsdelivr.net/npm/@vuelidate/core")"></script>
<script src="@Url.Content("https://cdn.jsdelivr.net/npm/@vuelidate/validators")"></script>


<div id="app">
    <form @@submit.prevent="submit">
        <input v-model="v$.name.$model">
        <div v-if="v$.name.$error">Name is required</div>
        <button type="submit">Submit</button>
    </form>
</div>

<script>
    const { createApp } = Vue
    const { useVuelidate } = Vuelidate
    const { required, email, minLength, sameAs } = VuelidateValidators

    //Vue.use(Vuelidate);

    createApp({
        setup() {
            return { v$: useVuelidate() }
        },

        data() {
            return {
                name: ''
            }
        },
        validations() {
            return {
                name: { required }
            }
        },
        methods: {
            async submit() {
                const result = await this.v$.$validate()
                if (!result) {
                    // notify user form is invalid
                    return
                }
                // perform async actions
            }
        }
    }).mount('#app')

