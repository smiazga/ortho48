@using Newtonsoft.Json;

@Html.Partial("~/VueComponents/Common/ModalNotification.cshtml")
@Html.Partial("~/VueComponents/ManagePatients/CreatePatient.cshtml")
@Html.Partial("~/VueComponents/ManagePatients/PatientDetails.cshtml")
@Html.Partial("~/VueComponents/Common/Spinner.cshtml")
<script src="~/Scripts/moment.js"></script>

<div id="patients">
    <div class="container">
        <div id="patient-info" v-show="isPatientInfoVisible">
            <div class="d-flex justify-content-between">
                <div><input type="text" placeholder="Patient or email" v-model="searchTerm" /></div>
                <div><button class="btn btn-primary" @@click="showCreatePatient()">Add Patient</button></div>
            </div>

            <table class="border-light">
                <thead>
                    <tr>
                        <th @@click="sortPatientInfo('PatientName')">Patient</th>
                        <th @@click="sortPatientInfo('DateRegistered')">Date registered</th>
                        <th @@click="sortPatientInfo('OrdersCount')">Orders</th>
                        <th @@click="sortPatientInfo('SubscriptionsCount')">Subscriptions</th>
                        <th>&nbsp;</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="p in filteredAndSortedPatients">
                        <td>
                            {{ p.PatientInitials}} {{ p.PatientName }} {{ p.PatientEmail }}
                        </td>
                        <td>
                            {{ toDateFormat(p.DateRegistered) }}
                        </td>
                        <td>
                            {{ p.OrdersCount }}
                        </td>
                        <td>
                            {{ p.SubscriptionsCount }}
                        </td>
                        <td>
                            <button class="btn btn-outline-primary" @@click="showPatientsDetails(p.CustomerId)">Details</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div><create-patient @@create-patient-result="handleCreatePatientResult" ref="createPatientModalRef"></create-patient></div>
        <div><patient-details :is-visible="isPatientDetailVisible" :id="patientDetailId" @@back="closePatientDetails"></patient-details></div>
        <div>
            <modal-notification ref="modalNotificationRef">
            </modal-notification>
        </div>
        <div>
            <spinner ref="spinnerRef"></spinner>
        </div>
    </div>
</div>

<script>

    const patients = Vue.createApp({
        data() {
            return {
                Patients: [],
                isPatientInfoVisible: true,
                isPatientDetailVisible: false,
                patientDetailId: 0,
                searchTerm: '',
                currentSort: 'PatientName',
                currentSortDir: 'asc'
            }
        },
        computed: {
            filteredAndSortedPatients() {
                return this.Patients.filter(p => {
                    const matchesSearch = p.PatientName.toLowerCase().includes(this.searchTerm.toLowerCase()) || p.PatientEmail.toLowerCase().includes(this.searchTerm.toLowerCase());
                    return matchesSearch;
                }).sort((a, b) => {
                    let modifier = 1;
                    if (this.currentSortDir === 'desc') modifier = -1;
                    if (a[this.currentSort] < b[this.currentSort]) return -1 * modifier;
                    if (a[this.currentSort] > b[this.currentSort]) return 1 * modifier;
                    return 0;
                });
            },
        },
        methods: {
            toDateFormat(value) {
                if (value != null) {
                    return moment(value.toString()).format('MMM Do, YYYY');
                }
                else {
                    return "-";
                }
            },
            sortPatientInfo(sort) {
                if (sort === this.currentSort) {
                    this.currentSortDir = this.currentSortDir === 'asc' ? 'desc' : 'asc';
                }
                this.currentSort = sort;
            },
            showPatientsDetails(patientId) {
                this.patientDetailId = patientId;
                this.isPatientInfoVisible = false;
                this.isPatientDetailVisible = true;
            },
            showCreatePatient() {
                this.isPatientDetailVisible = false;
                this.$refs.createPatientModalRef.showCreatePatientModal();
            },
            async handleCreatePatientResult(createResult) {
                this.$refs.createPatientModalRef.closeCreatePatientModal();
                if (createResult.Status == "success") {
                    this.patientHeader = await getFetch('/sfapi/patients/info/',null, this.$root.$refs.spinnerRef);
                }
                //this.$root.$refs.spinnerRef.hide();
            },
            closePatientDetails() {
                this.isPatientDetailVisible = false;
                this.isPatientInfoVisible = true;
            }
        },
        created: function () {
            this.Patients = @Html.Raw(JsonConvert.SerializeObject(Model.PatientInfoList));
        }
    });
    patients.component('create-patient', createPatientModal);
    patients.component('patient-details', patientDetails);
    patients.component('edit-patient', editPatientModal);
    patients.component('modal-notification', modalNotification);
    patients.component('spinner', spinner);
    patients.mount('#patients');

</script>